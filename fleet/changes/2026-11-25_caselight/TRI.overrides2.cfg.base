############################################# \
######## USER CONFIG OVERRIDES FILE #########  + --> This will help you personalize my config to your printer :)
############################################# /

# This file is yours! Feel free to edit it in order to include all the needed
# things to adapt my generic config to your machine. This file will not be erased
# when updating the config using moonraker and it will be kept as you've set it.
# You can change every section of the config. You can also add some new custom macros, etc...
# The corresponding documentation can be found in: docs > overrides.md

### Also, keep in mind: if you use a multi-MCU config such as the old school double SKRs or a CANbus toolhead
### board, you will need to specify which components are connected to which board in your own mcu.cfg file!
### Example: if something is connected to the toolhead MCU, you should use "config_pin: toolhead:PIN_NAME".

#> Main control MCUs are called "mcu" (and "secondary" when using a double MCU configuration)
#> Toolhead CANboard MCUs are called "toolhead"
#> MMU/ERCF MCUs are called "mmu"

# ------------------------------------------------------------------------------------------
# Machine: Voron Trident 250, LDO Monolith CNC gantry, BTT Octopus Max EZ (CAN bridge),
# BTT EBB36 Gen2, Cartographer V3 (Touch), Orbiter 2.5 + Orbiter 2 Smart Sensor.
# ------------------------------------------------------------------------------------------


#-------------------------#
#   START_PRINT SEQUENCE  #
#-------------------------#

## The START_PRINT sequence is modular and fully customizable. A default sequence is auto-populated based on
## your probe choice (TAP, Dockable, Inductive). If you still want to change it, uncomment the next 3 lines
## to define `variable_startprint_actions`. You can use any number of actions, and you can duplicate actions if needed.
## Available actions: "bed_soak", "extruder_preheating", "chamber_soak", "extruder_heating", "tilt_calib",
##                    "z_offset", "contact_z_home", "contact_auto_calibrate", "beacon_calib", "bedmesh",
##                    "purge", "clean", "primeline"
## You can add custom actions with a matching `_START_PRINT_ACTION_<NAME>` macro. Example:
##   variable_startprint_actions: "bed_soak", "my_start_action", "bedmesh", "primeline"
## Cartographer Touch should run contact_z_home after tilt_calib and before bedmesh.
## "skew_load" (macro just below) runs last, after the brush and the prime line, as the
## Klipper skew docs recommend.
[gcode_macro _USER_VARIABLES]
variable_startprint_actions: "bed_soak", "extruder_preheating", "chamber_soak", "tilt_calib", "clean", "contact_z_home", "bedmesh", "extruder_heating", "clean", "primeline", "skew_load"
gcode: # do not remove this line

## Loads the Califlower skew profile saved in printer.cfg for every print. Added 2026-11-09:
## the OrcaSlicer start G-code ran SKEW_PROFILE LOAD=CaliFlower, but profile names are case
## sensitive, so Klipper answered "Load failed, unknown profile" and printed without skew.
## The slicer line now says Califlower; loading the profile twice is harmless.
## Profile updated 2026-11-10: a CaliFlower printed WITH the old profile (-0.001706 rad)
## measured AC 99.57 / BD 99.54 / AD 70.4013, a leftover of +0.000301 rad, which was added
## to the old value: xy_skew is now -0.001405 rad (edited in printer.cfg's SAVE_CONFIG block).
## To refine it later: print the CaliFlower with the profile on, turn the measurements into a
## factor (SET_SKEW XY=AC,BD,AD then GET_CURRENT_SKEW) and ADD it to the saved xy_skew.
## Saving that SET_SKEW result with SKEW_PROFILE SAVE would keep only the leftover error.
[gcode_macro _START_PRINT_ACTION_SKEW_LOAD]
description: Apply the Califlower skew correction profile
gcode:
    SKEW_PROFILE LOAD=Califlower

## Legacy START_PRINT slots `custom1` through `custom9` are also supported and call
## `_MODULE_CUSTOM1` through `_MODULE_CUSTOM9`.
##
# [gcode_macro _USER_VARIABLES]
# variable_startprint_actions: "action1", "action2", ...
# gcode: # do not remove this line

## The END_PRINT sequence is modular and fully customizable. A default sequence is auto-populated, but if you
## still want to change it, uncomment the next 3 lines to define `variable_endprint_actions`.
## You can use any number of actions, and you can duplicate actions if needed.
## Available actions: "retract_filament", "turn_off_heaters", "turn_off_fans", "turn_off_motors",
##                    "reset_limits"
## You can add custom actions with a matching `_END_PRINT_ACTION_<NAME>` macro. Example:
##   variable_endprint_actions: "retract_filament", "my_end_action", "turn_off_heaters"
##   [gcode_macro _END_PRINT_ACTION_MY_END_ACTION]
##   gcode:
##     ## Your custom END_PRINT G-code here
##
# [gcode_macro _USER_VARIABLES]
# variable_endprint_actions: "action1", "action2", ...
# gcode: # do not remove this line


#-------------------------#
#   EXTRUDER/BED PIDs     #
#-------------------------#

## Klippain's orbiter2.0.cfg sets ATC Semitec 104GT-2 / max_temp 270, hence the two
## sensor overrides here.
## PID values: PID_CALIBRATE on 2026-11-09 with Klipper v0.13.0-822, which fixed the old
## formula that gave values twice too high. Hotend at 270C, bed at 110C, part fan off,
## chamber about 23C. Previous values: hotend 30.613 / 6.377 / 36.738,
## bed 50.469 / 2.549 / 249.819.
[extruder]
control: pid
pid_kp: 21.230
pid_ki: 5.242
pid_kd: 21.496
sensor_type: PT1000
max_temp: 300

[heater_bed]
control: pid
pid_kp: 37.981
pid_ki: 2.482
pid_kd: 145.279

## [verify_heater] is left at Klipper's defaults (max_error 120, hysteresis 5,
## heating_gain 2, check_gain_time 20 s hotend / 60 s bed). klippy.log shows the hotend
## heating ~8 C/s and the bed ~1 C/s, far above what those checks require.


#-------------------------#
#   MOTION                #
#-------------------------#

## Klippain wires the axis with non-inverted dir_pin by default, so only the motors
## that actually needed flipping appear here. Z1 and Z2 run in the default direction.
[stepper_x]
dir_pin: !X_DIR

[stepper_y]
dir_pin: !Y_DIR
endstop_pin: ^Y_STOP   # adds the pull-up that a [board_pins] alias cannot carry

## max_accel: the skipped-step test of 2026-11-10 (400 mm/s, 5 rounds, X/Y at 1.2 A, cold
## machine) passed at 10000 and at 12000 mm/s2. 10000 keeps a margin and stays under the Y
## input shaper limit (MZV 62.2 Hz, about 11300). Previous value: 9000.
[printer]
max_accel: 10000
square_corner_velocity: 10.0   # Klippain's corexy.cfg ships 5.0


#-------------------------#
#   TMC DRIVERS           #
#-------------------------#

## X/Y: LDO 42STH48-2804AH (2.8 A rated). Klippain's 0.8 A stalled on fast diagonal moves.
[tmc5160 stepper_x]
run_current: 1.2

[tmc5160 stepper_y]
run_current: 1.2

## Orbiter 2.5 (LDO 36STH20-1004AHG): the Orbiter docs give 0.85 A with interpolation off.
## Klippain's TMC2209.cfg ships 0.45 A, which its own orbiter2.0.cfg calls too low.
[tmc2209 extruder]
run_current: 0.75
interpolate: False


#---------------------------------------#
#   Autotune TMC                        #
#---------------------------------------#
## Autotune assumes a 24 V motor supply. If X/Y are powered at 48 V, add "voltage: 48"
## to the two stepper sections below.
[autotune_tmc stepper_x]
motor: ldo-42sth48-2804ah

[autotune_tmc stepper_y]
motor: ldo-42sth48-2804ah

[autotune_tmc extruder]
motor: ldo-36sth20-1004ahg


#-------------------------#
#      INPUT SHAPER       #
#-------------------------#

## Test point at the bed centre, the same point as variable_resonnance_test_point_xy
## (used by TEST_RESONANCES). Shake&Tune and SHAPER_CALIBRATE read it from here.
[resonance_tester]
probe_points:
    125, 125, 20
accel_per_hz: 100
sweeping_period: 0   # pulse-only test, as used for the current Shake&Tune results
max_freq: 200   # Klippain sets 135, which cut the X test off below the real X peak (176 Hz)

## From the Shake&Tune runs of 2026-11-10 (pulse-only, accel_per_hz 100).
## The "performance" choices are used on both axes (your choice, 2026-11-10).
## X was measured up to 200 Hz: main peak 176.0 Hz, second peak 93.3 Hz. EI 149.4 Hz leaves
## 5.4% vibrations, smoothing 0.024, max accel 40640. The low-vibration alternative is
## 2hump_ei at 149.8 Hz (0.5%, smoothing 0.038, max accel 23980).
## Y: two peaks, 55.7 and 75.2 Hz. MZV 62.2 Hz leaves 3.1%, smoothing 0.065, max accel
## 11330, so Y is what limits max_accel. The low-vibration alternative is EI at 77.2 Hz
## (1.0%, smoothing 0.066, max accel 10840).
## Previous values (run of 2026-10-13, X cut off at 133 Hz): X ei 108.4 / 0.046,
## Y mzv 62.4 / 0.054.
## Measure again after any belt or gantry work.
[input_shaper]
shaper_type_x: ei
shaper_freq_x: 149.4
damping_ratio_x: 0.042
shaper_type_y: mzv
shaper_freq_y: 62.2
damping_ratio_y: 0.068


#-------------------------#
#      CARTOGRAPHER       #
#-------------------------#
[cartographer]
y_offset: 21   # Klippain's cartographer_touch.cfg ships 15


#---------------------------#
#      MISC                 #
#---------------------------#
[temperature_sensor Chamber]
sensor_type: Generic 3950   # Klippain ships ATC Semitec 104GT-2

## Shake&Tune module, all options left at their defaults
[shaketune]

[skew_correction]


#---------------------------#
#      ADD-ONS              #
#---------------------------#
## Skipped-step test (Ellis TEST_SPEED). Klippain ships a test_speed.cfg but never
## includes it, so this file is the only TEST_SPEED macro on the machine.
[include TEST_SPEED.cfg]

## Orbiter 2 Smart Sensor: runout, auto-load, unload button, tangle alarm
[include oss_only.cfg]

## 2026-11-25 (DHH): bat caselight trang sau moi lan Klipper khoi dong.
## Klippain _INIT_LEDS dat STATUS_LEDS READY -> caselight 'standby' (0.01), nhin nhu tat.
## Chay sau startup cua Klippain; 0.8 = mau 'on' cua Klippain (day GRB, khong kenh W).
[delayed_gcode _DHH_CASELIGHT_STARTUP]
initial_duration: 5
gcode:
    SET_LED LED=caselight RED=0.8 GREEN=0.8 BLUE=0.8
